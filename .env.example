# Spotify app: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# slskd (see README for installation and API key)
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=

# slskd's downloads folder (directories.downloads in slskd.yml). Finished
# tracks are left at the top of this folder as "Artist - Title.ext".
DOWNLOAD_DIR=C:\Users\YOUR_USER\Music\slskd-downloads

PREFERRED_FORMATS=flac,mp3
MIN_BITRATE=256
SEARCH_TIMEOUT_SECONDS=20
DOWNLOAD_TIMEOUT_SECONDS=600
