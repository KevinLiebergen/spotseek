# Spotify app: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: also download your SoundCloud likes (must be public).
# The "user" part of https://soundcloud.com/user. Leave empty to disable.
SOUNDCLOUD_USER=

# slskd (see README for installation and API key)
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=

# slskd's downloads folder (directories.downloads in slskd.yml). Finished
# tracks are left at the top of this folder as "Artist - Title.ext".
DOWNLOAD_DIR=C:\Users\YOUR_USER\Music\slskd-downloads

# Optional: every finished track is also copied here (e.g. your rekordbox
# collection). The original stays in DOWNLOAD_DIR. Leave empty to disable.
COPY_TO_DIR=

# Genre sorting (see config/genres.example.yaml): the copy goes into the
# matching genre subfolder of COPY_TO_DIR when the classifier is confident.
SORT_BY_GENRE=true
# Optional, both free and both improve the classification:
# https://www.discogs.com/settings/developers ("Generate new token")
DISCOGS_TOKEN=
# https://www.last.fm/api/account/create (only the API key, not the secret)
LASTFM_API_KEY=

# rekordbox: after each run, relocate moved tracks, add new ones and keep a
# playlist per genre folder inside this playlist folder. Only while
# rekordbox is closed; master.db is backed up first. See README.
REKORDBOX_SYNC=false
REKORDBOX_PLAYLIST_FOLDER=my_music

PREFERRED_FORMATS=flac,mp3
MIN_BITRATE=256
SEARCH_TIMEOUT_SECONDS=20
DOWNLOAD_TIMEOUT_SECONDS=600
