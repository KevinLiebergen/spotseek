# Spotify app: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# slskd (see README for installation and API key)
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=

# Optional, improves genre classification when Spotify has no artist genres
# Create one at: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Root folder of your rekordbox collection, the one containing the per-genre subfolders
REKORDBOX_ROOT=C:\Users\YOUR_USER\Music\Rekordbox

# Name of the subfolder where tracks whose genre couldn't be mapped end up
UNCLASSIFIED_FOLDER=Unclassified

PREFERRED_FORMATS=flac,mp3
MIN_BITRATE=256
SEARCH_TIMEOUT_SECONDS=20
DOWNLOAD_TIMEOUT_SECONDS=600
